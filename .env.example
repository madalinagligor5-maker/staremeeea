# Public application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only. Prefer a restricted Stripe key in production.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Opțional: prețuri definite în Stripe Dashboard. Fără ele, prețul se creează la plată (25 lei/lună, 225 lei/an).
STRIPE_CARTE_MONTHLY_PRICE_ID=
STRIPE_CARTE_ANNUAL_PRICE_ID=
# "optional" = proba de 3 zile pornește fără card. Gol = proba cere card.
CARTE_TRIAL_CARD=
# "on" = Cartea cere abonament activ. Gol = deschisă (testare).
CARTE_PAYWALL=

# Transactional email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Ritualul de azi <hello@ritualuldeazi.ro>

# Pre-lansare: lasă necompletat. "carte" = lansarea Cărții (Prețuri, cont, plată). "off" = se deschide tot.
NEXT_PUBLIC_LAUNCH_MODE=
NEXT_PUBLIC_GA_ID=
